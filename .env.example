# Local overrides. Copy to .env (gitignored) — never commit real credentials.
# Valhalla service URL used by the API
VALHALLA_URL=http://127.0.0.1:8002
VALHALLA_PORT=8002
VALHALLA_THREADS=2

# Reuse an existing Valhalla graph instead of building one
# VALHALLA_CONFIG=/opt/valhalla/data/valhalla.json
# VALHALLA_BIN_DIR=/opt/valhalla-venv/bin

# Generated routing tiles, MVT, and road index
NA_DATA_DIR=./data/generated

# API binding
NA_HOST=127.0.0.1
NA_PORT=8004

# Set to 1 to reuse an existing webapp/dist instead of running npm
# SKIP_WEB=1

# Optional: local Tianditu key for the web app (or put it in webapp/.env.local)
# VITE_TDT_KEY=
